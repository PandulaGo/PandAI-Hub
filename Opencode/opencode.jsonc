{
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  "instructions": [
    "C:/Repositories/AI Hub/development-docs/API-Documentation.md",
    "C:/Repositories/AI Hub/development-docs/Architecture.md",
    "C:/Repositories/AI Hub/development-docs/Schema-Details.md",
    "C:/Repositories/AI Hub/development-docs/Session-Details.md"
  ],
  "agent": {
    "doc-agent": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "temperature": 0.2,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "deny"
      },
     "prompt": "You are the Dedicated Documentation Agent running on the Big Pickle model. Your core responsibility is to sync codebase changes directly back to the project workspace files inside the local `./docs/` folder. Follow ONLY the structural rules, layouts, and session logging guidelines defined in 'Architecture and Other Details.md' and 'Context Ledger.md' from the global instructions, and ignore any non-documentation instruction files for this task."
    },
    "plan": {
      "model": "opencode/big-pickle"
    }
  }
}